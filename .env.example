# Copy to .env and fill in. Secrets are read from the environment only and are
# never committed or read from config.toml.

CVA_TELEGRAM_TOKEN=
# Required only for llm_provider = "openai_compatible" (see docs/providers.md);
# not needed for the default llm_provider = "claude_code".
CVA_LLM_API_KEY=

# Beacon bridge shared secret (beacons extension → cva loopback endpoint).
# Unset (empty) DISABLES the endpoint: no port is bound at startup.
CVA_BRIDGE_SECRET=

# Optional overrides (defaults: https://api.openai.com/v1, gpt-4o-mini).
# The coding endpoint may override the model server-side (e.g. resolves to
# glm-5.3-flash) regardless of what is configured here.
# CVA_LLM_BASE_URL=https://api.openai.com/v1
# CVA_LLM_MODEL=gpt-4o-mini

# GLM-style endpoints: send "thinking": {"type": "disabled"} in the request
# body (recommended with temperature 0 + json_schema response format).
# CVA_LLM_DISABLE_THINKING=false

# Single bounded retry for transient LLM HTTP 429: wait these seconds and
# retry ONCE. 0 disables the retry (default: 25).
# CVA_LLM_429_RETRY_WAIT_SECONDS=25
