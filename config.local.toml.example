# Your personal settings — `cli.py init` writes this file as
# "config.local.toml" (gitignored); you can also edit it by hand.
#
# config.local.toml overrides config.toml; any CVA_<FIELD> environment
# variable overrides both. Secrets (tokens, API keys) live in .env, never
# here. Every setting: README.md "Configuration" and docs/running.md.

# Set by the bot when you pair with it (/start <code>); 0 = not paired yet.
owner_telegram_id = 0

# Interface language of the bot, the CLI and the panel: "auto" (default, your
# system language), "en" or "es" to force one. CVs and cover letters keep
# following each offer's language.
# ui_language = "es"

# AI provider and model: docs/providers.md.
# claude_code_path = "claude"   # full path to the claude CLI if not on PATH

# Gmail sync (read-only; proposes status changes from replies to your
# applications). Off by default. See docs/gmail.md.
# gmail_enabled = true
# gmail_credentials_path = "~/.config/cva/gmail_credentials.json"
# gmail_token_path = "~/.config/cva/gmail_token.json"
# gmail_poll_minutes = 60   # minimum 30

# Kill switch default. The Telegram /pausa and /reanudar toggle (persistent)
# wins once used; this only applies until then. See docs/portals.md.
# paused = false

# Portals allowed to feed the bot; unset = every registered portal.
# Unknown ids are a startup error. See docs/portals.md.
# enabled_portals = ["linkedin", "infojobs"]
